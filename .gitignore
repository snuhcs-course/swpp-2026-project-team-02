# Shared ignore rules for the frontend and backend.
**/__pycache__/
*.py[cod]
**/.env
backend/config/user_availability.json
**/.idea
backend/license_planner/output/
/backend/coverage-results/
# Test runner outputs are regenerated on every run; keep only each folder's README.
/backend/*_test_results/*
!/backend/*_test_results/README.md
