# Shared ignore rules for the frontend and backend.
**/__pycache__/
*.py[cod]
**/.env
backend/config/user_availability.json
**/.idea
backend/license_planner/output/
/backend/coverage-results/
# Scenario runner outputs are regenerated on every run; keep only each folder's README.
/backend/scenarios/results/*/*
!/backend/scenarios/results/*/README.md
backend/assessment_questionnaire/output/
.vscode/
